{
  "layer": "top",
  "position": "top",
  "height": 34,
  "margin-top": 6,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "reload_style_on_change": true,

  "modules-left": ["custom/nixos", "group/workspaces", "mpris"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "cpu", "memory", "temperature", "battery", "custom/power"],

  // ------------------------------ left ------------------------------
  "custom/nixos": {
    "format": "",
    "tooltip": false,
    "on-click": "pkill rofi || rofi -show drun"
  },

  // One script instance per workspace so each one is clickable.
  // Add/remove entries here to change the number of workspaces.
  "group/workspaces": {
    "orientation": "horizontal",
    "modules": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5"]
  },
  "custom/ws1": {
    "exec": "$HOME/.config/waybar/scripts/workspace.py 1",
    "return-type": "json",
    "restart-interval": 3,
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = '1' })\""
  },
  "custom/ws2": {
    "exec": "$HOME/.config/waybar/scripts/workspace.py 2",
    "return-type": "json",
    "restart-interval": 3,
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = '2' })\""
  },
  "custom/ws3": {
    "exec": "$HOME/.config/waybar/scripts/workspace.py 3",
    "return-type": "json",
    "restart-interval": 3,
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = '3' })\""
  },
  "custom/ws4": {
    "exec": "$HOME/.config/waybar/scripts/workspace.py 4",
    "return-type": "json",
    "restart-interval": 3,
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = '4' })\""
  },
  "custom/ws5": {
    "exec": "$HOME/.config/waybar/scripts/workspace.py 5",
    "return-type": "json",
    "restart-interval": 3,
    "on-click": "hyprctl dispatch \"hl.dsp.focus({ workspace = '5' })\""
  },

  "mpris": {
    "format": "{player_icon} {dynamic}",
    "format-paused": "{status_icon} {dynamic}",
    "format-stopped": "",
    "dynamic-order": ["title", "artist"],
    "dynamic-len": 40,
    "player-icons": {
      "default": "",
      "mpv": "",
      "firefox": "",
      "chromium": ""
    },
    "status-icons": { "paused": "" },
    "on-click": "play-pause"
  },

  // ----------------------------- center -----------------------------
  "clock": {
    "interval": 1,
    "format": "  {:%a %d %b  %H:%M:%S}",
    "tooltip-format": "{:%A %d %B %Y}",
    "on-click": "pkill yad || yad --calendar --undecorated --close-on-unfocus --no-buttons"
  },

  // ------------------------------ right -----------------------------
  "network": {
    "interval": 2,
    "format-wifi": "   {bandwidthDownBytes:>9}   {bandwidthUpBytes:>9}",
    "format-ethernet": "   {bandwidthDownBytes:>9}   {bandwidthUpBytes:>9}",
    "format-disconnected": "⚠ offline",
    "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
    "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": " muted",
    "format-icons": { "default": ["", ""] },
    "scroll-step": 5,
    "on-click": "pavucontrol",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "on-click": "kitty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "tooltip-format": "{used:0.1f} GiB / {total:0.1f} GiB",
    "on-click": "kitty -e btop"
  },

  "temperature": {
    // If the value looks wrong, find your sensor with:
    //   for f in /sys/class/hwmon/hwmon*/temp*_input; do echo "$f: $(cat $f)"; done
    // then uncomment and adjust:
    // "hwmon-path": "/sys/class/hwmon/hwmon2/temp1_input",
    "critical-threshold": 80,
    "format": "{icon} {temperatureC}°C",
    "format-icons": ["", "", "", "", ""],
    "on-click": "kitty -e btop"
  },

  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon} {capacity}%",
    "format-charging": " {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{timeTo}"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "~/.config/waybar/power_menu.xml",
    "menu-actions": {
      "lock": "hyprlock",
      "reboot": "systemctl reboot",
      "shutdown": "systemctl poweroff"
    }
  }
}
